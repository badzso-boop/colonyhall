{
  "name": "colonyhall-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Colonyhall PWA (React + Vite + TypeScript + Tailwind). Built into web/dist and embedded in the Go server at /app/.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/keep-dist.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "postinstall": "node scripts/go-ignore-node-modules.mjs"
  },
  "dependencies": {
    "i18next": "26.5.12",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.1.9",
    "react-router": "8.5.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
