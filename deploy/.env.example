# Copy to deploy/.env (gitignored, chmod 600). docker compose reads it for
# compose.dev.yaml. Never commit the real values.

# Interface the dev server listens on: 127.0.0.1 (default). 0.0.0.0 lets Gitea
# webhooks and phones reach it over Tailscale; in WSL's default NAT mode it is
# still not reachable from the LAN (only from Windows and Tailscale).
COLONY_BIND=127.0.0.1

# Gitea: read-only token (read:repository, read:issue) and the webhook secret
# that is also set on the Gitea webhook.
# API address the server calls (keep it internal, e.g. Tailscale) and the
# public address people use in links (optional; cards recognise both).
COLONY_GITEA_URL=http://100.x.y.z:3002
COLONY_GITEA_PUBLIC_URL=https://gitea.example.com
COLONY_GITEA_TOKEN=
COLONY_GITEA_WEBHOOK_SECRET=

# Live preview (round 57): the server's reverse proxy to running previews
# listens on its own port, so a preview gets its own origin. The guard's
# preview_host must be an address this server reaches (e.g. Tailscale).
# COLONY_PREVIEW_ORIGIN only when browsers reach it under another address
# (behind a reverse proxy, HTTPS), e.g. https://preview.example.com
COLONY_PREVIEW_PORT=8081
COLONY_PREVIEW_ORIGIN=

# Search (round 36): embedding server and reranker; empty = keyword search only.
COLONY_EMBED_URL=
COLONY_RERANK_URL=

# Login limits (round 40): failed logins are counted per handle (5) and per
# client IP (20) in a sliding 15-minute window, in the database. Addresses
# listed here are never locked out (their password is still checked and every
# failure is audited). Comma-separated IPs or CIDRs; empty by default.
# Example: 127.0.0.1/32,::1/128,192.0.2.10
COLONY_LOGIN_ALLOWLIST=
# Reverse proxies whose X-Forwarded-For header is believed (IPs or CIDRs).
# Empty (the default): the client address is always the TCP peer, and the
# header is ignored. Set it only when a proxy you run sits in front.
COLONY_TRUSTED_PROXIES=
