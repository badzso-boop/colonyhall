# Production settings for deploy/compose.yaml. Copy to deploy/.env on the
# server (gitignored), chmod 600. Never commit the real values.

# The homelab's Tailscale IP: the server listens only there.
COLONY_BIND=100.85.111.88
COLONY_PORT=8080

# Shared Postgres: own database and least-privilege user (see the recipe in
# ~/homelab/SHARED-POSTGRES.md).
COLONY_DATABASE_URL=postgres://colonyhall_app:CHANGE_ME@homelab-shared-postgres:5432/colonyhall?sslmode=disable

# Gitea on the same host, internal address only (read-only token).
COLONY_GITEA_URL=http://100.85.111.88:3002
COLONY_GITEA_PUBLIC_URL=https://gitea.ujjweb.hu
COLONY_GITEA_TOKEN=
COLONY_GITEA_WEBHOOK_SECRET=

# Search (round 36, docs/11-rag-terv.md): the Raspberry Pi's embedding server
# and the homelab reranker (docs/12, docs/13). Empty: keyword search only / no rerank.
COLONY_EMBED_URL=
COLONY_RERANK_URL=
# How many candidates go to the reranker (2–100, default 30).
COLONY_RERANK_TOP=
