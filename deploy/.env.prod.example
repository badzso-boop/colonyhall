# Production settings for deploy/compose.yaml. Copy to deploy/.env on the
# server (gitignored), chmod 600. Never commit the real values.

# The server's private address (e.g. its Tailscale IP): it listens only there.
COLONY_BIND=100.64.0.10
COLONY_PORT=8080

# Shared Postgres on the shared-db-net network: its own database and a
# least-privilege user.
COLONY_DATABASE_URL=postgres://colonyhall_app:CHANGE_ME@shared-postgres:5432/colonyhall?sslmode=disable

# Optional: Gitea, internal address only (read-only token); docs/04.
COLONY_GITEA_URL=http://100.64.0.10:3002
COLONY_GITEA_PUBLIC_URL=https://gitea.example.com
COLONY_GITEA_TOKEN=
COLONY_GITEA_WEBHOOK_SECRET=

# Search (round 36, docs/11-rag-terv.md): the embedding server and the
# reranker, e.g. the containers of deploy/embed/compose.yaml and
# deploy/rerank/compose.yaml (http://embed:8090, http://rerank:8091; docs/13).
# Empty: keyword search only / no rerank.
COLONY_EMBED_URL=
COLONY_RERANK_URL=
# How many candidates go to the reranker (2–100, default 10), and how long one
# rerank may take (100ms–1m, default 5s; past it the search is not reranked).
COLONY_RERANK_TOP=
COLONY_RERANK_TIMEOUT=

# Multi-tenant mode (docs/23-elkulonites.md): one subdomain per workspace,
# <slug>.<COLONY_BASE_DOMAIN>. Leave it off for a single-team server.
COLONY_MULTITENANT=0
COLONY_BASE_DOMAIN=

# Round 51 (docs/24-hosztolt-ajanlat.md). production (the default) or
# development; the operator's developer access (COLONY_OPERATOR_DEV_ACCESS=1)
# only starts with development. COLONY_SECRET_KEYS encrypts the secrets the
# server must read back (the operators' TOTP secrets, the Workshop's
# connector tokens): create one with
# `colonyhall secret-key`; required in multi-tenant mode. Rotation: the new
# key first, the old one after it, `colonyhall rotate-secrets`, then drop the
# old one. Keep a copy apart from the database backups.
COLONY_ENV=production
COLONY_OPERATOR_DEV_ACCESS=0
COLONY_SECRET_KEYS=
# The addresses admin.<domain> (the operator's console) answers, IPs or CIDRs,
# comma-separated, e.g. your Tailscale network 100.64.0.0/10. Every other
# address gets the same 404 as an unknown host, so nobody outside can try
# (or lock out) the operator's login. Empty: any address; not advised.
COLONY_OPERATOR_ALLOWLIST=

# Round 56a, the Workshop (docs/25-onfejlesztes-terv.md 13.7): the internal
# addresses its connectors may reach, comma-separated CIDRs, addresses or host
# names (e.g. a Gitea on your LAN: 192.168.1.10 or gitea.lan). Empty: public
# https addresses only. Refused in multi-tenant mode.
COLONY_EGRESS_ALLOW=

# Where this server's source code can be downloaded (AGPL section 13); the web
# app links there. Empty: the upstream repository. Set it if you run a
# modified version.
COLONY_SOURCE_URL=

# Login limits (round 40): failed logins are counted per handle (5) and per
# client IP (20) in a sliding 15-minute window, in the database. Addresses
# listed here are never locked out (their password is still checked and every
# failure is audited). Comma-separated IPs or CIDRs; empty by default.
# Example: 127.0.0.1/32,::1/128,192.0.2.10
COLONY_LOGIN_ALLOWLIST=
# Reverse proxies whose X-Forwarded-For header is believed (IPs or CIDRs).
# Empty (the default): the client address is always the TCP peer, and the
# header is ignored. Set it only when a proxy you run sits in front.
COLONY_TRUSTED_PROXIES=
